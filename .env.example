# Required: your Crustdata API key (https://docs.crustdata.com)
CRUSTDATA_API_KEY=

# discover mode: your customer accounts and the titles your champions hold
CUSTOMER_DOMAINS=acme.com,example.io
CHAMPION_TITLES=Revenue Operations,Sales Operations,Head of Sales,VP Sales
SINCE_DAYS=90

# Optional: Slack incoming webhook for alerts (leave empty to skip)
SLACK_WEBHOOK_URL=

# Optional: Claude drafts a first line per move (pip install -r requirements-optional.txt)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
